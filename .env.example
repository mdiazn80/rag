# Fija una versión estable concreta (comprueba la última en GitHub Releases)
LITELLM_VERSION=v1.99.1

# PostgreSQL
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changethis
POSTGRES_DB=litellm

# Debe empezar por "sk-". Genera con: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-changethis

# Acceso a la UI (http://<host>:4000/ui)
UI_USERNAME=admin
UI_PASSWORD=sk-changethis
